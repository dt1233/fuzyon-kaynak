
<%- include('partials/header') %>
    <!-- ============================================
         PAGE BANNER
         ============================================ -->
    <section class="page-banner">
        <div class="page-banner__overlay"></div>
        <div class="container">
            <h1 class="page-banner__title"><%= typeof settings !== 'undefined' && settings.page_references_title ? settings.page_references_title : 'Referanslar' %></h1>
            <div class="page-banner__breadcrumb">
                <a href="/"><%= typeof settings !== 'undefined' && settings.nav_home ? settings.nav_home : 'Ana Sayfa' %></a>
                <i class="fa-solid fa-chevron-right"></i>
                <span><%= typeof settings !== 'undefined' && settings.nav_references ? settings.nav_references : 'Referanslar' %></span>
            </div>
        </div>
    </section>
    <!-- ============================================
         WHY CHOOSE US SECTION (EXPLANATORY TEXT)
         ============================================ -->
    <section class="section" id="references-why">
        <div class="container">
            <div style="text-align: center; max-width: 800px; margin: 0 auto; padding-bottom: 2rem;">
                <div class="animate-on-scroll animate-scale">
                    <div class="about__subtitle" style="justify-content: center;">
                        <i class="fa-solid fa-minus"></i>
                        <%= settings.ref_why_subtitle || "Neden Biz?" %>
                        <i class="fa-solid fa-minus"></i>
                    </div>
                    <h2 class="about__title"><%= settings.ref_cta_title || "Referans Portföyümüzü Birlikte Büyütelim" %></h2>
                    <p class="references__text">
                        <%= settings.ref_why_desc1 || "Ak Füzyon olarak Malatya'da elektrofüzyon kaynak sektöründe öncü konumumuzu sürdürüyoruz. Kurulduğumuz günden bu yana kalite, güvenilirlik ve müşteri memnuniyetini temel ilke edindik." %>
                    </p>
                    <p class="references__text" style="margin-top: 16px;">
                        <%= settings.ref_why_desc2 || "Her projede uluslararası standartlara uygun ekipman ve tekniklerle çalışıyor, sızıntısız ve uzun ömürlü boru birleştirme garantisi sunuyoruz. Referans portföyümüz her geçen gün büyümektedir." %>
                    </p>

                    <div class="about__highlights" style="margin-top: 2rem; justify-content: center; display: flex; flex-wrap: wrap; gap: 15px;">
                        <% 
                        let featuresStr = settings.ref_cta_features || 'Zamanında Proje Teslimi,Sertifikalı Ekipman,Uzman Teknik Kadro,Rekabetçi Fiyatlandırma';
                        let featuresArr = featuresStr.split(',');
                        featuresArr.forEach(feature => { 
                            if(feature.trim()){
                        %>
                        <div class="about__highlight">
                            <i class="fa-solid fa-circle-check"></i>
                            <span><%= feature.trim() %></span>
                        </div>
                        <% }}); %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         REFERENCES GRID
         ============================================ -->
    <section class="section bg-light" id="references-grid">
        <div class="container">
            <div class="section-header text-center animate-on-scroll">
                <h2 class="section-title">Çözüm Ortaklarımız</h2>
                <div class="section-line"></div>
            </div>
            
            <div class="references__grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 30px; margin-top: 40px;">
                <% if(references && references.length > 0) { %>
                    <% references.forEach((ref, index) => { %>
                        <div class="reference-logo animate-on-scroll animate-delay-<%= (index % 4) + 1 %>" style="background: white; padding: 20px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.05); aspect-ratio: 1; border: 1px solid rgba(0,0,0,0.05);">
                            <img src="<%= ref.image_url %>" alt="<%= ref.title %>" style="max-width: 100%; max-height: 100px; object-fit: contain; filter: grayscale(100%) opacity(0.7); transition: all 0.3s ease;" onmouseover="this.style.filter='grayscale(0) opacity(1)'" onmouseout="this.style.filter='grayscale(100%) opacity(0.7)'">
                            <% if (ref.title) { %>
                                <div style="margin-top: 15px; font-weight: bold; font-size: 0.9rem; color: var(--text-color); text-align: center;"><%= ref.title %></div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="text-align: center; grid-column: 1 / -1;">Henüz referans eklenmemiş.</p>
                <% } %>
            </div>
        </div>
    </section>

    <!-- ============================================
         CERTIFICATES GRID
         ============================================ -->
    <% if(certificates && certificates.length > 0) { %>
    <section class="section" id="certificates-grid">
        <div class="container">
            <div class="section-header text-center animate-on-scroll">
                <h2 class="section-title">Belge ve Sertifikalarımız</h2>
                <div class="section-line"></div>
            </div>
            
            <div class="certificates__grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 30px; margin-top: 40px;">
                <% certificates.forEach((cert, index) => { %>
                    <div class="certificate-card animate-on-scroll animate-delay-<%= (index % 4) + 1 %>" style="background: white; padding: 15px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); text-align: center; border: 1px solid rgba(0,0,0,0.05);">
                        <img src="<%= cert.image_url %>" alt="<%= cert.title %>" style="width: 100%; height: auto; border-radius: 4px; border: 1px solid #eee;">
                        <% if (cert.title) { %>
                            <div style="margin-top: 15px; font-weight: bold; font-size: 1rem; color: var(--primary);"><%= cert.title %></div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- ============================================
         CTA BANNER (PARALLAX)
         ============================================ -->
<section class="cta-banner" id="cta-banner" <% if (settings.home_hero_bg_2) { %>style="background-image: url('<%= settings.home_hero_bg_2 %>');"<% } %>>
        <div class="cta-banner__overlay"></div>
        <div class="container">
            <div class="cta-banner__content animate-on-scroll animate-scale">
                <h2 class="cta-banner__title"><%= settings.ref_bottom_cta_title || "Referans Ortağımız Olun!" %></h2>
                <p class="cta-banner__text">
                    <%= settings.ref_bottom_cta_desc || "Elektrofüzyon kaynak ihtiyaçlarınız için Ak Füzyon'u tercih edin. Projelerinizde güvenilir çözüm ortağınız olalım ve birlikte başarılı işlere imza atalım. Hemen iletişime geçin, ücretsiz keşif ve fiyat teklifi sunalım." %>
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="/iletisim" class="btn btn--primary btn--lg">
                        <i class="<%- renderIconClass(settings.ref_bottom_cta_btn1_icon, 'fa-paper-plane') %>"></i>
                        <%= settings.ref_bottom_cta_btn1 || "İletişime Geçin" %>
                    </a>
                    <a href="https://wa.me/<%= settings.whatsapp %>?text=Merhaba,%20referans%20ortaklığı%20hakkında%20bilgi%20almak%20istiyorum." class="btn btn--white btn--lg" target="_blank">
                        <i class="<%- renderIconClass(settings.ref_bottom_cta_btn2_icon, 'fa-whatsapp') %>"></i>
                        <%= settings.ref_bottom_cta_btn2 || "WhatsApp ile Yazın" %>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         FOOTER
         ============================================ -->
    <%- include('partials/footer') %>


