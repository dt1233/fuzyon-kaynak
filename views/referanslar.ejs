<%- include('partials/header') %>

    <!-- ============================================
         PAGE BANNER
         ============================================ -->
    <section class="page-banner">
        <div class="page-banner__overlay"></div>
        <div class="container">
            <h1 class="page-banner__title"><%= typeof settings !== 'undefined' && settings.nav_references ? settings.nav_references : 'Referanslar' %></h1>
            <div class="page-banner__breadcrumb">
                <a href="/"><%= typeof settings !== 'undefined' && settings.nav_home ? settings.nav_home : 'Ana Sayfa' %></a>
                <i class="fa-solid fa-chevron-right"></i>
                <span><%= typeof settings !== 'undefined' && settings.nav_references ? settings.nav_references : 'Referanslar' %></span>
            </div>
        </div>
    </section>

    <!-- ============================================
         REFERENCES INTRO SECTION
         ============================================ -->
    <section class="section" id="references-intro">
        <div class="container">
            <div class="section-header animate-on-scroll">
                <h2><%= settings.references_page_title || "Güvenilir Çözüm Ortaklıkları" %></h2>
                <p>
                    <%= settings.references_page_desc || "Ak Füzyon olarak, Malatya'nın ilk ve tek elektrofüzyon kaynak hizmeti firması olmanın sorumluluğuyla her projemizde en yüksek kaliteyi sunuyoruz. Bölgemizde büyüyen referans portföyümüzle, sektörde güvenilir bir marka olmaya devam ediyoruz." %>
                </p>
            </div>
        </div>
    </section>

    <!-- ============================================
         REFERENCE CARDS GRID
         ============================================ -->
    <section class="section section--alt" id="references-grid">
        <div class="container">
            <div class="section-header animate-on-scroll">
                <h2><%= settings.ref_grid_title || "Hizmet Verdiğimiz Alanlar" %></h2>
                <p><%= settings.ref_grid_desc || "Farklı sektör ve proje türlerinde elektrofüzyon kaynak çözümlerimizle güçlü iş birlikleri kuruyoruz." %></p>
            </div>

            <div class="services__grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 3rem;">

                <!-- Card 1 - Belediye Projeleri -->
                <div class="service-card animate-on-scroll animate-delay-1">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_1_icon, 'fa-building-columns') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_1_title || "Sektör 1" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_1_desc || "Sektör 1 açıklaması" %></p>
                </div>

                <!-- Card 2 - İnşaat Firmaları -->
                <div class="service-card animate-on-scroll animate-delay-2">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_2_icon, 'fa-helmet-safety') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_2_title || "Sektör 2" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_2_desc || "Sektör 2 açıklaması" %></p>
                </div>

                <!-- Card 3 - Endüstriyel Tesisler -->
                <div class="service-card animate-on-scroll animate-delay-3">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_3_icon, 'fa-industry') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_3_title || "Sektör 3" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_3_desc || "Sektör 3 açıklaması" %></p>
                </div>

                <!-- Card 4 - Tarım Projeleri -->
                <div class="service-card animate-on-scroll animate-delay-4">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_4_icon, 'fa-seedling') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_4_title || "Sektör 4" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_4_desc || "Sektör 4 açıklaması" %></p>
                </div>

                <!-- Card 5 - Su İdareleri -->
                <div class="service-card animate-on-scroll animate-delay-1">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_5_icon, 'fa-droplet') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_5_title || "Sektör 5" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_5_desc || "Sektör 5 açıklaması" %></p>
                </div>

                <!-- Card 6 - Doğalgaz Altyapısı -->
                <div class="service-card animate-on-scroll animate-delay-2">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_6_icon, 'fa-fire-flame-simple') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_6_title || "Sektör 6" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_6_desc || "Sektör 6 açıklaması" %></p>
                </div>

                <!-- Card 7 - Maden ve Enerji -->
                <div class="service-card animate-on-scroll animate-delay-3">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_7_icon, 'fa-mountain-sun') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_7_title || "Sektör 7" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_7_desc || "Sektör 7 açıklaması" %></p>
                </div>

                <!-- Card 8 - Altyapı Müteahhitleri -->
                <div class="service-card animate-on-scroll animate-delay-4">
                    <div class="service-card__icon">
                        <i class="<%- renderIconClass(settings.ref_card_8_icon, 'fa-road') %>"></i>
                    </div>
                    <h3 class="service-card__title"><%= settings.ref_card_8_title || "Sektör 8" %></h3>
                    <p class="service-card__text"><%= settings.ref_card_8_desc || "Sektör 8 açıklaması" %></p>
                </div>

            </div>
        </div>
    </section>

    <!-- ============================================
         WHY CHOOSE US SECTION
         ============================================ -->
    <section class="section" id="references-why">
        <div class="container">
            <div class="references__grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
                <div class="animate-on-scroll animate-left">
                    <div class="about__subtitle">
                        <i class="fa-solid fa-minus"></i>
                        <%= settings.ref_why_subtitle || "Neden Biz?" %>
                    </div>
                    <h2 class="about__title"><%= settings.ref_cta_title || "Referans Portföyümüzü Birlikte Büyütelim" %></h2>
                    <p class="references__text">
                        <%= settings.ref_why_desc1 || "Ak Füzyon olarak Malatya'da elektrofüzyon kaynak sektöründe öncü konumumuzu sürdürüyoruz. Kurulduğumuz günden bu yana kalite, güvenilirlik ve müşteri memnuniyetini temel ilke edindik." %>
                    </p>
                    <p class="references__text" style="margin-top: 16px;">
                        <%= settings.ref_why_desc2 || "Her projede uluslararası standartlara uygun ekipman ve tekniklerle çalışıyor, sızıntısız ve uzun ömürlü boru birleştirme garantisi sunuyoruz. Referans portföyümüz her geçen gün büyümektedir." %>
                    </p>

                    <div class="about__highlights" style="margin-top: 2rem;">
                        <% 
                        let featuresStr = settings.ref_cta_features || 'Zamanında Proje Teslimi,Sertifikalı Ekipman,Uzman Teknik Kadro,Rekabetçi Fiyatlandırma';
                        let featuresArr = featuresStr.split(',');
                        featuresArr.forEach(feature => { 
                            if(feature.trim()){
                        %>
                        <div class="about__highlight">
                            <i class="fa-solid fa-circle-check"></i>
                            <span><%= feature.trim() %></span>
                        </div>
                        <% }}); %>
                    </div>
                </div>

                <div class="animate-on-scroll animate-right">
                    <div class="references__logos">
                        <% for(let i=1; i<=6; i++) { 
                            let refLogo = settings['ref_logo_' + i] || ('Referans ' + i);
                        %>
                            <% if (refLogo.startsWith('/uploads/')) { %>
                                <div class="reference-logo" style="padding: 10px;">
                                    <img src="<%= refLogo %>" alt="Referans <%= i %>" style="max-width: 100%; max-height: 80px; object-fit: contain;">
                                </div>
                            <% } else { %>
                                <div class="reference-logo"><%= refLogo %></div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         CTA SECTION
         ============================================ -->
    <section class="cta-banner" id="cta-banner" <% if (settings.home_cta_bg) { %>style="background-image: url('<%= settings.home_cta_bg %>');"<% } %>>
        <div class="cta-banner__overlay"></div>
        <div class="container">
            <div class="cta-banner__content animate-on-scroll animate-scale">
                <h2 class="cta-banner__title"><%= settings.ref_bottom_cta_title || "Referans Ortağımız Olun!" %></h2>
                <p class="cta-banner__text">
                    <%= settings.ref_bottom_cta_desc || "Elektrofüzyon kaynak ihtiyaçlarınız için Ak Füzyon'u tercih edin. Projelerinizde güvenilir çözüm ortağınız olalım ve birlikte başarılı işlere imza atalım. Hemen iletişime geçin, ücretsiz keşif ve fiyat teklifi sunalım." %>
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="/iletisim" class="btn btn--primary btn--lg">
                        <i class="<%- renderIconClass(settings.ref_bottom_cta_btn1_icon, 'fa-paper-plane') %>"></i>
                        <%= settings.ref_bottom_cta_btn1 || "İletişime Geçin" %>
                    </a>
                    <a href="https://wa.me/<%= settings.whatsapp %>?text=Merhaba,%20referans%20ortaklığı%20hakkında%20bilgi%20almak%20istiyorum." class="btn btn--white btn--lg" target="_blank">
                        <i class="<%- renderIconClass(settings.ref_bottom_cta_btn2_icon, 'fa-whatsapp') %>"></i>
                        <%= settings.ref_bottom_cta_btn2 || "WhatsApp ile Yazın" %>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         FOOTER
         ============================================ -->
    <%- include('partials/footer') %>


