    <footer class="footer" id="footer">
        <div class="container">
            <div class="footer__grid">
                <div>
                    <h4 class="footer__heading"><%= settings.footer_col1_title || "Ak Füzyon" %></h4>
                    <p class="footer__about-text">
                        <%= settings.footer_about_text || "Malatya ve çevre illerde elektrofüzyon kaynak hizmeti sunan ilk ve tek firma. Uzman kadromuz ve son teknoloji ekipmanlarımızla altyapı projelerinizde güvenilir çözüm ortağınız." %>
                    </p>
                    <div class="footer__social">
                        <% if (settings.iletisim_facebook && settings.iletisim_facebook.trim() !== '') { %>
                        <a href="<%= settings.iletisim_facebook %>"><i class="<%- renderIconClass(settings.footer_facebook_icon, 'fa-facebook-f') %>"></i></a>
                        <% } %>
                        <% if (settings.iletisim_instagram && settings.iletisim_instagram.trim() !== '') { %>
                        <a href="<%= settings.iletisim_instagram %>"><i class="<%- renderIconClass(settings.footer_instagram_icon, 'fa-instagram') %>"></i></a>
                        <% } %>
                        <% if (settings.iletisim_youtube && settings.iletisim_youtube.trim() !== '') { %>
                        <a href="<%= settings.iletisim_youtube %>"><i class="<%- renderIconClass(settings.footer_youtube_icon, 'fa-youtube') %>"></i></a>
                        <% } %>
                        <% if (settings.iletisim_linkedin && settings.iletisim_linkedin.trim() !== '') { %>
                        <a href="<%= settings.iletisim_linkedin %>"><i class="<%- renderIconClass(settings.footer_linkedin_icon, 'fa-linkedin-in') %>"></i></a>
                        <% } %>
                    </div>
                </div>
                <div>
                    <h4 class="footer__heading"><%= settings.footer_col2_title || "Hızlı Linkler" %></h4>
                    <ul class="footer__links">
                        <li><a href="/"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_home || "Anasayfa" %></a></li>
                        <% if (settings.page_about_active !== 'false') { %>
                        <li><a href="/<%= slugs.about %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_about || "Hakkımızda" %></a></li>
                        <% } %>
                        <% if (settings.page_products_active !== 'false') { %>
                        <li><a href="/<%= slugs.products %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_products || "Ürünler" %></a></li>
                        <% } %>
                        <% if (settings.page_services_active !== 'false') { %>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_services || "Hizmetlerimiz" %></a></li>
                        <% } %>
                        <% if (settings.page_gallery_active !== 'false') { %>
                        <li><a href="/<%= slugs.gallery || 'galeri' %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_gallery || "Galeri" %></a></li>
                        <% } %>
                        <% if (settings.page_blog_active !== 'false') { %>
                        <li><a href="/<%= slugs.blog || 'blog' %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_blog || "Blog" %></a></li>
                        <% } %>
                        <% if (settings.page_contact_active !== 'false') { %>
                        <li><a href="/<%= slugs.contact %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_contact || "İletişim" %></a></li>
                        <% } %>
                    </ul>
                </div>
                <div>
                    <h4 class="footer__heading"><%= settings.footer_col3_title || "Hizmetlerimiz" %></h4>
                    <ul class="footer__links">
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_1 || "Elektrofüzyon Kaynak" %></a></li>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_2 || "Alın Kaynak" %></a></li>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_3 || "PE Boru Montajı" %></a></li>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_4 || "Boru Hattı Tamiri" %></a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="footer__heading"><%= settings.footer_col4_title || "İletişim" %></h4>
                    <ul class="footer__contact">
                        <% if (settings.address && settings.address.trim() !== '') { %>
                        <li><i class="<%- renderIconClass(settings.footer_address_icon, 'fa-location-dot') %>"></i><span><%= settings.address %></span></li>
                        <% } %>
                        <% if (settings.phone && settings.phone.trim() !== '') { %>
                        <li><i class="<%- renderIconClass(settings.footer_phone_icon, 'fa-phone') %>"></i><span><%= settings.phone %></span></li>
                        <% } %>
                        <% if (settings.email && settings.email.trim() !== '') { %>
                        <li><i class="<%- renderIconClass(settings.footer_email_icon, 'fa-envelope') %>"></i><span><%= settings.email %></span></li>
                        <% } %>
                        <% if (settings.working_hours && settings.working_hours.trim() !== '') { %>
                        <li><i class="<%- renderIconClass(settings.footer_hours_icon, 'fa-clock') %>"></i><span><%= settings.working_hours %></span></li>
                        <% } %>
