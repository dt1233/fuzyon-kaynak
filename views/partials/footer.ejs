                        <% if (settings.page_contact_active !== 'false') { %>
                        <li><a href="/<%= slugs.contact %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_contact || "İletişim" %></a></li>
                        <% } %>
                    </ul>
                </div>
                <div>
                    <h4 class="footer__heading"><%= settings.footer_col3_title || "Hizmetlerimiz" %></h4>
                    <ul class="footer__links">
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_1 || "Elektrofüzyon Kaynak" %></a></li>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_2 || "Alın Kaynak" %></a></li>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_3 || "PE Boru Montajı" %></a></li>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.footer_service_4 || "Boru Hattı Tamiri" %></a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="footer__heading"><%= settings.footer_col4_title || "İletişim" %></h4>
                    <ul class="footer__contact">
