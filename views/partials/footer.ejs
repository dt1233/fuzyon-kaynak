                    <ul class="footer__links">
                        <li><a href="/"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_home || "Anasayfa" %></a></li>
                        <% if (settings.page_about_active !== 'false') { %>
                        <li><a href="/<%= slugs.about %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_about || "Hakkımızda" %></a></li>
                        <% } %>
                        <% if (settings.page_products_active !== 'false') { %>
                        <li><a href="/<%= slugs.products %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_products || "Ürünler" %></a></li>
                        <% } %>
                        <% if (settings.page_services_active !== 'false') { %>
                        <li><a href="/<%= slugs.services %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_services || "Hizmetlerimiz" %></a></li>
                        <% } %>
                        <% if (settings.page_gallery_active !== 'false') { %>
                        <li><a href="/<%= slugs.gallery || 'galeri' %>"><i class="fa-solid fa-chevron-right"></i> <%= settings.nav_gallery || "Galeri" %></a></li>
                        <% } %>
                        <% if (settings.page_blog_active !== 'false') { %>
