%>
<div style="display: flex; align-items: center; gap: 10px;">
    <select class="icon-select" name="<%= name %>" style="flex: 1; margin: 0; padding: 10px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text);">
        <% icons.forEach(icon => { %> 
            <option value="<%= icon.val %>" data-icon="<%= icon.val %>" <%= actualVal === icon.val ? 'selected' : '' %>><%= icon.name %></option> 
        <% }); %>
    </select>
