<%- include('header') %>

<div class="admin-header">
    <div class="header-content">
        <h2><i class="fa-solid fa-images" style="color: var(--accent); margin-right: 10px;"></i> Belge ve Sertifikalar</h2>
        <p style="color: var(--text-secondary); margin-top: 5px;">Web sitesindeki galeri fotoğraflarını yönetin.</p>
    </div>
</div>

<div class="admin-card" style="margin-bottom: 30px;">
    <h3>Yeni Fotoğraf Yükle</h3>
    <form action="/admin/certificates/add" method="POST" enctype="multipart/form-data">
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Fotoğraflar Seçin (Çoklu Seçim Yapabilirsiniz)</label>
            <input type="file" name="images" accept="image/*" multiple required style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px;">
        </div>
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Başlık / Açıklama (İsteğe Bağlı)</label>
            <input type="text" name="title" style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px;" placeholder="Fotoğraf için kısa bir açıklama...">
        </div>
        <button type="submit" class="btn btn--primary"><i class="fa-solid fa-upload"></i> Yükle</button>
    </form>
</div>

<div class="admin-card">
    <h3>Yüklü Fotoğraflar</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-top: 20px;">
        <% if (certificates && certificates.length > 0) { %>
            <% certificates.forEach(item => { %>
                <div style="position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                    <img src="<%= item.image_url %>" style="width: 100%; height: 200px; object-fit: cover; display: block;" alt="<%= item.title %>">
                    <% if (item.title) { %>
                        <div style="position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(0,0,0,0.6); color: white; padding: 10px; font-size: 0.85rem; text-align: center;">
                            <%= item.title %>
                        </div>
                    <% } %>
                    <form action="/admin/certificates/delete/<%= item.id %>" method="POST" style="position: absolute; top: 10px; right: 10px;" onsubmit="return confirm('Bu fotoğrafı silmek istediğinize emin misiniz?');">
                        <button type="submit" style="background: #e74c3c; color: white; border: none; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
            <% }) %>
        <% } else { %>
            <div style="grid-column: 1 / -1; padding: 40px; text-align: center; color: var(--text-secondary); background: #f8f9fa; border-radius: 8px;">
                <i class="fa-solid fa-images" style="font-size: 3rem; color: #ccc; margin-bottom: 15px;"></i>
                <p>Henüz galeriye fotoğraf yüklenmemiş.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('footer') %>
