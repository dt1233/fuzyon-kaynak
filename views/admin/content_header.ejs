<%- include('header') %>
<div class="admin-header"><h2>Header Yönetimi</h2></div>
<% if (success) { %><div style="background: #2ecc71; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px;"><%= success %></div><% } %>
<form action="/admin/content/update" method="POST" class="admin-card">
    <input type="hidden" name="redirect_to" value="header">
    <div style="display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 30px;">
        <div class="form-group" style="margin: 0;"><label>Logo Yazısı</label><input type="text" name="header_logo_text" value="<%= settings.header_logo_text || 'Ak Füzyon' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Logo Alt Başlık</label><input type="text" name="header_logo_tagline" value="<%= settings.header_logo_tagline || 'Elektrofüzyon Kaynak' %>"></div>
    </div>
    
    <h3 style="margin: 0 0 15px 0; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); color: var(--accent);">Üst Çubuk (Top Bar)</h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 30px;">
        <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
            <label>Telefon</label>
            <input type="text" name="iletisim_telefon" value="<%= settings.iletisim_telefon || '' %>">
            <label style="margin-top: 10px;">Telefon İkonu</label>
            <%- include('icon_selector', {name: 'header_phone_icon', currentVal: settings.header_phone_icon, defaultIcon: 'fa-phone'}) %>
        </div>
        <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
            <label>E-posta</label>
            <input type="text" name="iletisim_eposta" value="<%= settings.iletisim_eposta || '' %>">
            <label style="margin-top: 10px;">E-posta İkonu</label>
            <%- include('icon_selector', {name: 'header_email_icon', currentVal: settings.header_email_icon, defaultIcon: 'fa-envelope'}) %>
        </div>
        <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
            <label>Facebook URL</label>
            <input type="text" name="iletisim_facebook" value="<%= settings.iletisim_facebook || '' %>">
            <label style="margin-top: 10px;">Facebook İkonu</label>
            <%- include('icon_selector', {name: 'header_facebook_icon', currentVal: settings.header_facebook_icon, defaultIcon: 'fa-facebook-f'}) %>
        </div>
        <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
            <label>Instagram URL</label>
            <input type="text" name="iletisim_instagram" value="<%= settings.iletisim_instagram || '' %>">
            <label style="margin-top: 10px;">Instagram İkonu</label>
            <%- include('icon_selector', {name: 'header_instagram_icon', currentVal: settings.header_instagram_icon, defaultIcon: 'fa-instagram'}) %>
        </div>
        <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
            <label>Twitter URL</label>
            <input type="text" name="iletisim_twitter" value="<%= settings.iletisim_twitter || '' %>">
            <label style="margin-top: 10px;">Twitter İkonu</label>
            <%- include('icon_selector', {name: 'header_twitter_icon', currentVal: settings.header_twitter_icon, defaultIcon: 'fa-twitter'}) %>
        </div>
    </div>
    
    <h3 style="margin: 0 0 15px 0; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); color: var(--accent);">Menü Linkleri</h3>
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-bottom: 30px;">
        <div class="form-group" style="margin: 0;"><label>Ana Sayfa</label><input type="text" name="nav_home" value="<%= settings.nav_home || '' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Hakkımızda</label><input type="text" name="nav_about" value="<%= settings.nav_about || '' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Hizmetlerimiz</label><input type="text" name="nav_services" value="<%= settings.nav_services || '' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Ürünler</label><input type="text" name="nav_products" value="<%= settings.nav_products || '' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Referanslar</label><input type="text" name="nav_references" value="<%= settings.nav_references || '' %>"></div>
        <div class="form-group" style="margin: 0;"><label>İletişim</label><input type="text" name="nav_contact" value="<%= settings.nav_contact || '' %>"></div>
    </div>
    <button type="submit" class="btn btn--primary" style="margin-top: 20px;">İçerikleri Kaydet</button>
</form>
<%- include('footer') %>
