<%- include('header') %>

<div class="admin-header">
    <div class="header-content">
        <h2><i class="fa-solid fa-plus" style="color: var(--accent); margin-right: 10px;"></i> Yeni Yazı Ekle</h2>
        <p style="color: var(--text-secondary); margin-top: 5px;">Sitenize yeni bir haber veya makale ekleyin.</p>
    </div>
    <a href="/admin/blogs" class="btn btn--secondary"><i class="fa-solid fa-arrow-left"></i> Geri Dön</a>
</div>

<div class="admin-card">
    <form action="/admin/blogs/add" method="POST" enctype="multipart/form-data">
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Yazı Başlığı</label>
            <input type="text" name="title" required style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px;" placeholder="Örn: Yeni Nesil Boru Kaynak Teknikleri">
        </div>
        
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Kapak Görseli</label>
            <input type="file" name="image" accept="image/*" style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px;">
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">İçerik (HTML destekler)</label>
            <textarea name="content" required rows="15" style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; font-family: monospace;" placeholder="<p>Makalenizi buraya yazın...</p>"></textarea>
            <small style="color: var(--text-secondary); display: block; margin-top: 5px;">İpucu: Paragraflar için &lt;p&gt;...&lt;/p&gt;, alt başlıklar için &lt;h3&gt;...&lt;/h3&gt; veya satır atlamak için &lt;br&gt; kullanabilirsiniz.</small>
        </div>

        <button type="submit" class="btn btn--primary" style="padding: 12px 30px; font-size: 1.1rem;"><i class="fa-solid fa-save"></i> Kaydet ve Yayınla</button>
    </form>
</div>

<%- include('footer') %>
