<%- include('header') %>
<div class="admin-header"><h2>Referanslar Yönetimi</h2></div>
<% if (success) { %><div style="background: #2ecc71; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px;"><%= success %></div><% } %>
<form action="/admin/content/update" method="POST" class="admin-card" enctype="multipart/form-data">
    <input type="hidden" name="redirect_to" value="references">
    
    <h3 style="margin: 0 0 15px 0; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); color: var(--accent);">Giriş Bölümü</h3>
    <div style="display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 40px;">
        <div class="form-group" style="margin: 0;"><label>Sayfa Başlığı</label><input type="text" name="references_page_title" value="<%= settings.references_page_title || 'Güvenilir Çözüm Ortaklıkları' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Açıklama Metni</label><textarea name="references_page_desc" rows="3"><%= settings.references_page_desc || "Ak Füzyon olarak, Malatya'nın ilk ve tek elektrofüzyon kaynak hizmeti firması olmanın sorumluluğuyla her projemizde en yüksek kaliteyi sunuyoruz. Bölgemizde büyüyen referans portföyümüzle, sektörde güvenilir bir marka olmaya devam ediyoruz." %></textarea></div>
    </div>

    <h3 style="margin: 30px 0 15px 0; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); color: var(--accent);">Neden Biz Bölümü</h3>
    <div style="display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 40px;">
        <div class="form-group" style="margin: 0;"><label>Küçük Üst Başlık</label><input type="text" name="ref_why_subtitle" value="<%= settings.ref_why_subtitle || 'Neden Biz?' %>"></div>
        <div class="form-group" style="margin: 0;"><label>Bölüm Ana Başlığı</label><input type="text" name="ref_cta_title" value="<%= settings.ref_cta_title || 'Referans Portföyümüzü Birlikte Büyütelim' %>"></div>
        <div class="form-group" style="margin: 0;"><label>1. Paragraf</label><textarea name="ref_why_desc1" rows="2"><%= settings.ref_why_desc1 || "Ak Füzyon olarak Malatya'da elektrofüzyon kaynak sektöründe öncü konumumuzu sürdürüyoruz. Kurulduğumuz günden bu yana kalite, güvenilirlik ve müşteri memnuniyetini temel ilke edindik." %></textarea></div>
        <div class="form-group" style="margin: 0;"><label>2. Paragraf</label><textarea name="ref_why_desc2" rows="2"><%= settings.ref_why_desc2 || "Her projede uluslararası standartlara uygun ekipman ve tekniklerle çalışıyor, sızıntısız ve uzun ömürlü boru birleştirme garantisi sunuyoruz. Referans portföyümüz her geçen gün büyümektedir." %></textarea></div>
        <div class="form-group" style="margin: 0;">
            <label>Özellikler (Virgülle Ayırın)</label>
            <input type="text" name="ref_cta_features" value="<%= settings.ref_cta_features || 'Zamanında Proje Teslimi,Sertifikalı Ekipman,Uzman Teknik Kadro,Rekabetçi Fiyatlandırma' %>">
        </div>
    </div>

    <h3 style="margin: 30px 0 15px 0; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); color: var(--accent);">Sayfa Sonu CTA (Çağrı) Alanı</h3>
    <div style="display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 40px;">
        <div class="form-group" style="margin: 0;"><label>CTA Başlığı</label><input type="text" name="ref_bottom_cta_title" value="<%= settings.ref_bottom_cta_title || 'Referans Ortağımız Olun!' %>"></div>
        <div class="form-group" style="margin: 0;"><label>CTA Açıklaması</label><textarea name="ref_bottom_cta_desc" rows="2"><%= settings.ref_bottom_cta_desc || "Elektrofüzyon kaynak ihtiyaçlarınız için Ak Füzyon'u tercih edin. Projelerinizde güvenilir çözüm ortağınız olalım ve birlikte başarılı işlere imza atalım. Hemen iletişime geçin, ücretsiz keşif ve fiyat teklifi sunalım." %></textarea></div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
            <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
                <label>Sol Buton Metni (İletişim)</label>
                <input type="text" name="ref_bottom_cta_btn1" value="<%= settings.ref_bottom_cta_btn1 || 'İletişime Geçin' %>">
                <label style="margin-top: 10px;">Sol Buton İkonu</label>
                <%- include('icon_selector', {name: 'ref_bottom_cta_btn1_icon', currentVal: settings.ref_bottom_cta_btn1_icon, defaultIcon: 'fa-paper-plane'}) %>
            </div>
            <div class="form-group" style="margin: 0; background: rgba(0,0,0,0.02); padding: 15px; border-radius: 8px;">
                <label>Sağ Buton Metni (WhatsApp)</label>
                <input type="text" name="ref_bottom_cta_btn2" value="<%= settings.ref_bottom_cta_btn2 || 'WhatsApp ile Yazın' %>">
                <label style="margin-top: 10px;">Sağ Buton İkonu</label>
                <%- include('icon_selector', {name: 'ref_bottom_cta_btn2_icon', currentVal: settings.ref_bottom_cta_btn2_icon, defaultIcon: 'fa-whatsapp'}) %>
            </div>
        </div>
    </div>
    
    <button type="submit" class="btn btn--primary" style="margin-top: 20px;">İçerikleri Kaydet</button>
</form>
<%- include('footer') %>
