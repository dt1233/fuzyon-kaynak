            <div style="text-align: center; margin-top: 40px; padding: 20px 0; border-top: 1px solid rgba(0,0,0,0.05); color: #888; font-size: 0.85rem;">
                <i class="fa-solid fa-code" style="color: #3498db; margin-right: 5px;"></i> <strong>Betsan Teknoloji v1.0.0 Admin Paneli</strong><br>
                <span style="font-size: 0.8rem; opacity: 0.8; display: inline-block; margin-top: 5px;">İşletmenizi dijitalin gücüyle geleceğe bağlayan akıllı yönetim altyapısı.</span>
            </div>
        </div>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
    $(document).ready(function() {
        function formatIcon(icon) {
            if (!icon.id) { return icon.text; }
            var iconClass = $(icon.element).attr('data-icon') || ('fa-solid ' + icon.id);
            var $icon = $('<span><i class="' + iconClass + '" style="margin-right: 8px; width: 20px; text-align: center;"></i> ' + icon.text + '</span>');
            return $icon;
        };
        $('.icon-select').select2({
            templateResult: formatIcon,
            templateSelection: formatIcon,
            width: '100%',
            dropdownAutoWidth: true
        });
        
        // Select2 uses its own events, so we update the preview box on change
        $('.icon-select').on('select2:select', function (e) {
            var iconClass = $(e.params.data.element).attr('data-icon') || ('fa-solid ' + e.params.data.id);
            $(this).closest('div').find('.icon-preview-box i').attr('class', iconClass);
        });
        
        // Mobile Sidebar Toggle
        $('#admin-menu-toggle').click(function() {
            $('#admin-sidebar').addClass('open');
            $('#admin-overlay').addClass('active');
            $('body').css('overflow', 'hidden'); // Prevent scrolling body
        });
        
        $('#admin-overlay').click(function() {
            $('#admin-sidebar').removeClass('open');
            $(this).removeClass('active');
            $('body').css('overflow', 'auto');
        });
    });
    </script>
</body>
</html>
