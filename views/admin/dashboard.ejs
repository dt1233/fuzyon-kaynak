<%- include('header') %>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="admin-header">
    <h2>Dashboard (Kontrol Paneli)</h2>
</div>

<!-- Stats Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <!-- Stat Card: Günlük Ziyaret -->
    <div style="background: linear-gradient(135deg, var(--primary) 0%, #1e3a8a 100%); color: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 5px;">Bugünün Ziyaretçisi</div>
            <div style="font-size: 2.5rem; font-weight: 700;"><%= stats.todayViews %></div>
        </div>
        <i class="fa-solid fa-users" style="font-size: 3rem; opacity: 0.3;"></i>
    </div>

    <!-- Stat Card: Toplam Ürün -->
    <div style="background: linear-gradient(135deg, var(--accent) 0%, #d35400 100%); color: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 5px;">Kayıtlı Ürün</div>
            <div style="font-size: 2.5rem; font-weight: 700;"><%= stats.products %></div>
        </div>
        <i class="fa-solid fa-box-open" style="font-size: 3rem; opacity: 0.3;"></i>
    </div>

    <!-- Stat Card: Kategori -->
    <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 5px;">Kategori Sayısı</div>
            <div style="font-size: 2.5rem; font-weight: 700;"><%= stats.categories %></div>
        </div>
        <i class="fa-solid fa-tags" style="font-size: 3rem; opacity: 0.3;"></i>
    </div>
</div>

<!-- Main Content Grid -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
    <!-- Chart Section -->
    <div class="admin-card" style="margin-bottom: 0;">
        <h3 style="margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">Son 7 Günün Trafik Akışı</h3>
        <div style="position: relative; height: 300px; width: 100%;">
            <canvas id="trafficChart"></canvas>
        </div>
    </div>

    <!-- Quick Actions & Info -->
    <div style="display: flex; flex-direction: column; gap: 20px;">
        <div class="admin-card" style="margin-bottom: 0;">
            <h3 style="margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">Hızlı Eylemler</h3>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <a href="/admin/products/add" class="btn btn--primary" style="text-align: center; width: 100%;"><i class="fa-solid fa-plus"></i> Yeni Ürün Ekle</a>
                <a href="/admin/settings" class="btn btn--outline" style="text-align: center; width: 100%;"><i class="fa-solid fa-cog"></i> Site Ayarları</a>
                <a href="/admin/content/home" class="btn btn--outline" style="text-align: center; width: 100%;"><i class="fa-solid fa-home"></i> Ana Sayfayı Düzenle</a>
            </div>
        </div>

        <div class="admin-card" style="margin-bottom: 0; background: var(--bg-secondary); border: 1px dashed var(--border-color);">
            <h4 style="margin-bottom: 10px; color: var(--primary);"><i class="fa-solid fa-lightbulb"></i> Google Analytics</h4>
            <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 10px;">
                Bu grafikte gördüğünüz veriler sitenizin iç sayaç sisteminden gelmektedir. Gerçek Google Analytics istatistikleri toplamak isterseniz, "Site Ayarları" kısmından <strong>Google Analytics (G-TAG)</strong> kodunuzu ekleyebilirsiniz.
            </p>
        </div>
    </div>
</div>

<script>
    // Parse chart data injected from server
    const chartData = <%- chartData || '{"labels":[], "data":[]}' %>;
    
    const ctx = document.getElementById('trafficChart').getContext('2d');
    
    // Create gradient for the area chart
    const gradient = ctx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0, 'rgba(30, 58, 138, 0.5)'); // primary color with opacity
    gradient.addColorStop(1, 'rgba(30, 58, 138, 0.0)');
    
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: chartData.labels,
            datasets: [{
                label: 'Ziyaretçi Sayısı',
                data: chartData.data,
                borderColor: '#1e3a8a', // primary color
                backgroundColor: gradient,
                borderWidth: 3,
                pointBackgroundColor: '#e67e22', // accent color
                pointBorderColor: '#fff',
                pointHoverBackgroundColor: '#fff',
                pointHoverBorderColor: '#e67e22',
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                tension: 0.4 // curvy lines
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    padding: 12,
                    titleFont: { size: 14 },
                    bodyFont: { size: 14 },
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return context.parsed.y + ' Ziyaretçi';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        stepSize: 10,
                        font: { size: 12 }
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        font: { size: 12 }
                    }
                }
            }
        }
    });
</script>

<%- include('footer') %>
