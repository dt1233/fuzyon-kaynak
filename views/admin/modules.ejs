<%- include('header') %>

<div class="admin-header">
    <div class="header-content">
        <h2><i class="fa-solid fa-toggle-on" style="color: var(--accent); margin-right: 10px;"></i> Modül & Sayfa Yönetimi</h2>
        <p style="color: var(--text-secondary); margin-top: 5px;">Web sitesinin şablonunu (aktif/pasif sayfaları ve bölümleri) tek tıkla yönetin.</p>
    </div>
</div>

<style>
    /* iOS Style Toggle Switch */
    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
    }
    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }
    .slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }
    input:checked + .slider {
        background-color: var(--primary);
    }
    input:checked + .slider:before {
        transform: translateX(24px);
    }

    .module-group {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 25px;
        margin-bottom: 30px;
    }
    .module-group h3 {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .module-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid var(--bg-secondary);
    }
    .module-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    .module-info h4 {
        margin: 0 0 5px 0;
        font-size: 1rem;
    }
    .module-info p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-secondary);
    }
</style>

<form action="/admin/modules" method="POST">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
        
        <!-- Sayfa Şalterleri -->
        <div class="module-group">
            <h3><i class="fa-solid fa-file-lines"></i> Sayfa Yönetimi</h3>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>Hakkımızda Sayfası</h4>
                    <p>Menüden ve siteden gizler.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_about_active" value="true" <%= settings.page_about_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>Ürünler Sayfası</h4>
                    <p>Ürün kataloğunu tamamen kapatır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_products_active" value="true" <%= settings.page_products_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>Galeri Sayfası</h4>
                    <p>Fotoğraf galerisini devre dışı bırakır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_gallery_active" value="true" <%= settings.page_gallery_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>

            <div class="module-item">
                <div class="module-info">
                    <h4>Blog & Haberler Sayfası</h4>
                    <p>Blog sistemini tamamen kapatır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_blog_active" value="true" <%= settings.page_blog_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>

            <div class="module-item">
                <div class="module-info">
                    <h4>Teklif Al Sayfası</h4>
                    <p>Menüdeki belirgin teklif butonunu kaldırır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_quote_active" value="true" <%= settings.page_quote_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>İletişim Sayfası</h4>
                    <p>İletişim formunu ve haritayı kapatır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_contact_active" value="true" <%= settings.page_contact_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>Hizmetlerimiz Sayfası</h4>
                    <p>Hizmetlerin listelendiği sayfayı kapatır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_services_active" value="true" <%= settings.page_services_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>Referanslar Sayfası</h4>
                    <p>Projelerin listelendiği sayfayı kapatır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="page_references_active" value="true" <%= settings.page_references_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <!-- Ana Sayfa Bölümleri -->
        <div class="module-group">
            <h3><i class="fa-solid fa-house"></i> Ana Sayfa Seksiyonları</h3>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>Neden Biz? (Özellikler)</h4>
                    <p>Kurumsal avantajlar bölümünü gizler.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="home_features_active" value="true" <%= settings.home_features_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>

            
            <div class="module-item">
                <div class="module-info">
                    <h4>Markalar & Partnerler</h4>
                    <p>Referans logoları kayan bandını kapatır.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="home_partners_active" value="true" <%= settings.home_partners_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>

        </div>

        <!-- Ekstra Araçlar -->
        <div class="module-group">
            <h3><i class="fa-solid fa-screwdriver-wrench"></i> Sistem Modülleri</h3>
            
            <div class="module-item">
                <div class="module-info">
                    <h4>WhatsApp Yüzen Butonu</h4>
                    <p>Sağ alttaki WhatsApp hızlı ikonunu aç/kapat.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="whatsapp_button_active" value="true" <%= settings.whatsapp_button_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>

            <div class="module-item" style="background: rgba(255,59,48,0.05); padding: 15px; border-radius: 8px; border: 1px solid rgba(255,59,48,0.2);">
                <div class="module-info">
                    <h4 style="color: #ff3b30;"><i class="fa-solid fa-person-digging"></i> Bakım Modu</h4>
                    <p>Site ziyaretçilerine kapatılır. Sadece adminler görebilir.</p>
                </div>
                <label class="switch">
                    <input type="checkbox" name="maintenance_mode_active" value="true" <%= settings.maintenance_mode_active === 'true' ? 'checked' : '' %>>
                    <span class="slider"></span>
                </label>
            </div>
        </div>

    </div>
    
    <div style="margin-top: 20px; text-align: right;">
        <button type="submit" class="btn btn--primary" style="font-size: 1.1rem; padding: 15px 40px;">
            <i class="fa-solid fa-save"></i> Değişiklikleri Kaydet
        </button>
    </div>
</form>

<%- include('footer') %>
