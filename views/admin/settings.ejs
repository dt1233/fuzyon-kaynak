<%- include('header') %>

<div class="admin-header">
    <h2>Genel Ayarlar</h2>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #e74c3c; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
        <%= error %>
    </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #2ecc71; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
        <%= success %>
    </div>
<% } %>

<form action="/admin/settings" method="POST" class="admin-card" onsubmit="return validatePasswords()">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div class="form-group">
            <label>Site Teması (Kapsamlı Tasarım Paketi)</label>
            
            <div style="display: flex; gap: 10px; align-items: center;">
                <select name="color_theme" style="flex: 1;">
                    <option value="klasik" <%= settings.color_theme === 'klasik' ? 'selected' : '' %>>Klasik Ak Füzyon</option>
                    <option value="kayisi" <%= settings.color_theme === 'kayisi' ? 'selected' : '' %>>Malatya Kayısısı</option>
                    <option value="deniz" <%= settings.color_theme === 'deniz' ? 'selected' : '' %>>Deniz Esintisi</option>
                    <option value="endustriyel" <%= settings.color_theme === 'endustriyel' ? 'selected' : '' %>>Endüstriyel Gri</option>
                    <option value="nemrut" <%= settings.color_theme === 'nemrut' ? 'selected' : '' %>>Nemrut Güneşi</option>
                    <option value="zeytin" <%= settings.color_theme === 'zeytin' ? 'selected' : '' %>>Ege Zeytini</option>
                    <option value="kapadokya" <%= settings.color_theme === 'kapadokya' ? 'selected' : '' %>>Kapadokya Toprağı</option>
                    <option value="karadeniz" <%= settings.color_theme === 'karadeniz' ? 'selected' : '' %>>Karadeniz Ormanı</option>
                    <option value="pamukkale" <%= settings.color_theme === 'pamukkale' ? 'selected' : '' %>>Pamukkale Travertenleri</option>
                    <option value="oltu" <%= settings.color_theme === 'oltu' ? 'selected' : '' %>>Erzurum Oltu Taşı</option>
                    <option value="harran" <%= settings.color_theme === 'harran' ? 'selected' : '' %>>Harran Kerpici</option>
                    <option value="custom" <%= settings.color_theme === 'custom' ? 'selected' : '' %>>Özel Tasarım (Sınırsız)</option>
                </select>
                <button type="button" id="custom-theme-edit-btn" style="display: <%= settings.color_theme === 'custom' ? 'block' : 'none' %>; padding: 10px 15px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-tertiary); cursor: pointer;" onclick="document.getElementById('custom-theme-modal').style.display='flex'" title="Özel Tasarımı Düzenle">
                    <i class="fas fa-edit"></i>
                </button>
            </div>

        </div>

        <div class="form-group">
            <label><i class="fa-brands fa-google"></i> Google Analytics İzleme Kodu (G-XXXXXXX)</label>
            <input type="text" name="google_analytics_id" value="<%= settings.google_analytics_id || '' %>" placeholder="Örn: G-1234567890">
            <small style="color: var(--text-secondary); display: block; margin-top: 5px;">Sitenizin ziyaretçi verilerini Google Analytics'e göndermek için izleme kodunuzu buraya girin.</small>
        </div>


        

        
        <script>
            document.querySelector('select[name="color_theme"]').addEventListener('change', function(e) {
                const editBtn = document.getElementById('custom-theme-edit-btn');
                if (e.target.value === 'custom') {
                    editBtn.style.display = 'block';
                    document.getElementById('custom-theme-modal').style.display = 'flex';
                } else {
                    editBtn.style.display = 'none';
                    document.getElementById('custom-theme-modal').style.display = 'none';
                }
            });
            
            // Link color inputs to text inputs
            document.querySelectorAll('input[type="color"]').forEach(input => {
                input.addEventListener('input', function(e) {
                    this.nextElementSibling.value = e.target.value.toUpperCase();
                });
            });
            
            // Close modal when clicking outside
            document.getElementById('custom-theme-modal').addEventListener('click', function(e) {
                if (e.target === this) {
                    this.style.display = 'none';
                }
            });
        </script>



    </div>
    
    <hr style="margin: 30px 0; border: 0; border-top: 1px solid var(--border-color);">
    <h3><i class="fa-solid fa-search"></i> SEO Ayarları</h3>
    <div style="display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 15px;">
        <div class="form-group">
            <label>Varsayılan Site Başlığı Eki (Örn: | Ak Füzyon)</label>
            <input type="text" name="seo_site_title_suffix" value="<%= settings.seo_site_title_suffix || ' | Ak Füzyon' %>" placeholder="Sayfa isimlerinin sonuna eklenecek kısım">
        </div>
        <div class="form-group">
            <label>Genel Site Açıklaması (Meta Description)</label>
            <textarea name="seo_site_description" rows="3" placeholder="Sitenizin Google'da görünecek genel açıklaması..."><%= settings.seo_site_description || '' %></textarea>
        </div>
        <div class="form-group">
            <label>Genel Anahtar Kelimeler (Meta Keywords)</label>
            <input type="text" name="seo_site_keywords" value="<%= settings.seo_site_keywords || '' %>" placeholder="Örn: elektrofüzyon, kaynak, altyapı, malatya">
        </div>
        <div class="form-group">
            <label>Sosyal Medya Kapak Fotoğrafı (Open Graph Image URL)</label>
            <input type="text" name="seo_og_image" value="<%= settings.seo_og_image || '' %>" placeholder="Örn: /images/logo.png veya http...">
        </div>
    </div>

    <hr style="margin: 30px 0; border: 0; border-top: 1px solid var(--border-color);">
    <h3>Admin Şifre Değiştir</h3>
    
    <div style="display: flex; gap: 20px; max-width: 60%; margin-top: 15px;">
        <div class="form-group" style="flex: 1;">
            <label>Yeni Şifre (Boş bırakırsanız değişmez)</label>
            <input type="password" id="newPassword" name="newPassword" placeholder="Yeni Şifreniz">
        </div>
        <div class="form-group" style="flex: 1;">
            <label>Yeni Şifre Tekrar (Doğrulama)</label>
            <input type="password" id="newPasswordConfirm" name="newPasswordConfirm" placeholder="Yeni Şifrenizi Tekrar Girin">
        </div>
    </div>
    <div id="passwordError" style="color: #e74c3c; font-size: 0.9rem; margin-top: 5px; display: none;">Şifreler birbiriyle uyuşmuyor!</div>


    <button type="submit" class="btn btn--primary" style="margin-top: 20px;">Ayarları Kaydet</button>

        <div id="custom-theme-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
            <div style="background: var(--card-bg); padding: 30px; border-radius: 16px; width: 90%; max-width: 500px; box-shadow: 0 15px 50px rgba(0,0,0,0.3); position: relative; border: 1px solid var(--border-color);">
                <button type="button" onclick="document.getElementById('custom-theme-modal').style.display='none'" style="position: absolute; right: 20px; top: 20px; background: none; border: none; font-size: 1.8rem; cursor: pointer; color: var(--text-muted); line-height: 1;">&times;</button>
                <h4 style="margin-bottom: 10px; color: var(--primary); font-size: 1.25rem;">Özel Tasarım Ayarları</h4>
                <p style="margin-bottom: 25px; font-size: 0.9rem; color: var(--text-secondary);">Sınırsız seçeneğinde temanızın kurumsal renklerini özgürce belirleyebilirsiniz.</p>
                
                <div class="form-group">
                    <label>Ana Renk (Primary Color) <small>Header, Footer, Kartlar</small></label>
                    <div style="display: flex; gap: 10px; align-items: center; background: var(--bg-secondary); padding: 10px; border-radius: 8px;">
                        <input type="color" name="custom_primary" value="<%= settings.custom_primary || '#2C3E50' %>" style="width: 50px; height: 40px; padding: 0; cursor: pointer; border: none; background: none;">
                        <input type="text" value="<%= settings.custom_primary || '#2C3E50' %>" readonly style="width: 100px; background: transparent; border: none; font-family: monospace; font-size: 1rem; color: var(--text-primary);">
                    </div>
                </div>
                
                <div class="form-group" style="margin-top: 15px;">
                    <label>Vurgu Rengi (Accent Color) <small>Butonlar, Linkler</small></label>
                    <div style="display: flex; gap: 10px; align-items: center; background: var(--bg-secondary); padding: 10px; border-radius: 8px;">
                        <input type="color" name="custom_accent" value="<%= settings.custom_accent || '#E74C3C' %>" style="width: 50px; height: 40px; padding: 0; cursor: pointer; border: none; background: none;">
                        <input type="text" value="<%= settings.custom_accent || '#E74C3C' %>" readonly style="width: 100px; background: transparent; border: none; font-family: monospace; font-size: 1rem; color: var(--text-primary);">
                    </div>
                </div>
                
                
                <div class="form-group" style="margin-top: 15px;">
                    <label>Header / Menü Düzeni</label>
                    <select name="custom_header_layout" style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-secondary); color: var(--text-primary);">
                        <option value="1" <%= settings.custom_header_layout === '1' ? 'selected' : '' %>>1. Tasarım: Modern (Açık Zemin / Yanda Logo)</option>
                        <option value="2" <%= settings.custom_header_layout === '2' ? 'selected' : '' %>>2. Tasarım: Klasik (Renkli Arka Plan)</option>
                        <option value="3" <%= settings.custom_header_layout === '3' ? 'selected' : '' %>>3. Tasarım: Ortalanmış (Logo Üstte, Menü Altta)</option>
                    </select>
                </div>

                <div class="form-group" style="margin-top: 15px;">
                    <label>Buton ve Kutu Köşe Yuvarlaklığı</label>
                    <select name="custom_btn_radius" style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-secondary); color: var(--text-primary);">
                        <option value="0px" <%= settings.custom_btn_radius === '0px' ? 'selected' : '' %>>Keskin / Köşeli (0px)</option>
                        <option value="8px" <%= settings.custom_btn_radius === '8px' ? 'selected' : '' %>>Hafif Yuvarlak (8px)</option>
                        <option value="20px" <%= settings.custom_btn_radius === '20px' ? 'selected' : '' %>>Yuvarlak (20px)</option>
                        <option value="50px" <%= settings.custom_btn_radius === '50px' ? 'selected' : '' %>>Tam Yuvarlak / Oval (50px)</option>
                    </select>
                </div>

                <div style="text-align: right; margin-top: 30px;">
                    <button type="button" onclick="document.getElementById('custom-theme-modal').style.display='none'" style="background: var(--primary); color: #fff; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">Tamam</button>
                </div>
            </div>
        </div>

</form>

<%- include('footer') %>

        <script>
            function validatePasswords() {
                const p1 = document.getElementById('newPassword').value;
                const p2 = document.getElementById('newPasswordConfirm').value;
                if (p1 !== p2) {
                    document.getElementById('passwordError').style.display = 'block';
                    return false;
                }
                document.getElementById('passwordError').style.display = 'none';
                return true;
            }
        </script>
