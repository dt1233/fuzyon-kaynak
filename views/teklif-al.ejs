<%- include('partials/header') %>

    <!-- ============================================
         PAGE BANNER
         ============================================ -->
    <section class="page-banner">
        <div class="page-banner__overlay"></div>
        <div class="container">
            <h1 class="page-banner__title">Teklif Talep Formu</h1>
            <div class="page-banner__breadcrumb">
                <a href="/"><%= typeof settings !== 'undefined' && settings.nav_home ? settings.nav_home : 'Ana Sayfa' %></a>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Teklif Al</span>
            </div>
        </div>
    </section>

<div class="container" style="padding: 60px 20px;">
    <div style="display: flex; flex-wrap: wrap; gap: 40px; background: var(--card-bg); box-shadow: 0 10px 40px rgba(0,0,0,0.05); border-radius: 20px; overflow: hidden;">
        
        <!-- Left Column: Form -->
        <div style="flex: 1 1 600px; padding: 50px;">
            <h2 style="font-size: 2rem; color: var(--text-primary); margin-bottom: 20px;">Teklif Talep Formu</h2>
            <div style="width: 50px; height: 3px; background: var(--accent); margin-bottom: 30px;"></div>
            
            <p style="color: var(--text-secondary); margin-bottom: 30px; line-height: 1.6;">
                Ak Füzyon mühendisleri, projenize özel fiyatlandırma ve teknik yönlendirme ile en doğru çözümü sunar. Lütfen aşağıdaki formu eksiksiz doldurun.
            </p>

            <form id="quote-form">
                <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 20px;">
                    <div style="flex: 1 1 250px;">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold; color: var(--text-secondary); font-size: 0.9rem;">Adınız <span style="color: var(--accent);">*</span></label>
                        <input type="text" name="first_name" required style="width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 8px; font-family: inherit; font-size: 1rem; transition: border-color 0.3s;" placeholder="Adınız">
                    </div>
                    <div style="flex: 1 1 250px;">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold; color: var(--text-secondary); font-size: 0.9rem;">Soyadınız <span style="color: var(--accent);">*</span></label>
                        <input type="text" name="last_name" required style="width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 8px; font-family: inherit; font-size: 1rem; transition: border-color 0.3s;" placeholder="Soyadınız">
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 30px;">
                    <div style="flex: 1 1 250px;">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold; color: var(--text-secondary); font-size: 0.9rem;">Email Adresiniz <span style="color: var(--accent);">*</span></label>
                        <input type="email" name="email" required style="width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 8px; font-family: inherit; font-size: 1rem; transition: border-color 0.3s;" placeholder="ornek@email.com">
                    </div>
                    <div style="flex: 1 1 250px;">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold; color: var(--text-secondary); font-size: 0.9rem;">Telefon Numaranız <span style="color: var(--accent);">*</span></label>
                        <input type="tel" name="phone" required style="width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 8px; font-family: inherit; font-size: 1rem; transition: border-color 0.3s;" placeholder="+90 5XX XXX XX XX">
                    </div>
                </div>

                <label style="display: block; margin-bottom: 15px; font-weight: bold; color: var(--text-secondary); font-size: 0.9rem;">İlgilenilen Ürün Kategorileri <span style="color: var(--accent);">*</span></label>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px;">
                    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                        <% categories.forEach(function(category) { %>
                            <label style="display: flex; align-items: center; gap: 10px; padding: 10px 15px; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; transition: all 0.3s;">
                                <input type="checkbox" name="products" value="<%= category.name %>">
                                <span style="font-size: 0.95rem; color: var(--text-primary);"><%= category.name %></span>
                            </label>
                        <% }); %>
                    <% } else { %>
                        <label style="display: flex; align-items: center; gap: 10px; padding: 10px 15px; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; transition: all 0.3s;">
                            <input type="checkbox" name="products" value="Genel Ürünler">
                            <span style="font-size: 0.95rem; color: var(--text-primary);">Genel Ürünler</span>
                        </label>
                    <% } %>
                    <label style="display: flex; align-items: center; gap: 10px; padding: 10px 15px; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; transition: all 0.3s;">
                        <input type="checkbox" name="products" value="Diğer" id="diger-checkbox">
                        <span style="font-size: 0.95rem; color: var(--text-primary);">Diğer</span>
                    </label>
                </div>
                
                <div id="diger-textarea-container" style="display: none; margin-bottom: 30px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold; color: var(--text-secondary); font-size: 0.9rem;">Lütfen Belirtiniz</label>
                    <textarea id="diger-textarea" rows="3" style="width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 8px; font-family: inherit; font-size: 1rem; transition: border-color 0.3s;" placeholder="İlgilendiğiniz diğer ürün veya hizmetleri buraya yazabilirsiniz..."></textarea>
                </div>

                <button type="submit" class="btn btn--primary" style="width: 100%; padding: 15px; font-size: 1.1rem;">Teklif İste</button>
            </form>
        </div>

        <!-- Right Column: Info Panel -->
        <div style="flex: 1 1 400px; background: var(--accent); color: white; padding: 50px; display: flex; flex-direction: column; justify-content: center;">
            <h2 style="font-size: 2.2rem; margin-bottom: 20px;">Projenize Özel Teklif Alın</h2>
            
            <ul style="list-style: none; padding: 0; margin-bottom: 40px;">
                <li style="margin-bottom: 15px; font-size: 1.1rem; display: flex; align-items: center; gap: 15px;">
                    <i class="fa-solid fa-check-circle" style="font-size: 1.2rem;"></i> Dünya Çapında İhracat
                </li>
                <li style="margin-bottom: 15px; font-size: 1.1rem; display: flex; align-items: center; gap: 15px;">
                    <i class="fa-solid fa-check-circle" style="font-size: 1.2rem;"></i> 24 Saat İçinde Teklif Garantisi
                </li>
                <li style="margin-bottom: 15px; font-size: 1.1rem; display: flex; align-items: center; gap: 15px;">
                    <i class="fa-solid fa-check-circle" style="font-size: 1.2rem;"></i> Profesyonel Mühendislik Desteği
                </li>
                <li style="margin-bottom: 15px; font-size: 1.1rem; display: flex; align-items: center; gap: 15px;">
                    <i class="fa-solid fa-check-circle" style="font-size: 1.2rem;"></i> TSE & ISO Sertifikalı Üretim
                </li>
                <li style="margin-bottom: 15px; font-size: 1.1rem; display: flex; align-items: center; gap: 15px;">
                    <i class="fa-solid fa-check-circle" style="font-size: 1.2rem;"></i> Yüksek Kalite Standartları
                </li>
            </ul>

            <h3 style="font-size: 1.8rem; margin-bottom: 20px;">Neden Ak Füzyon?</h3>
            <ul style="list-style: none; padding: 0;">
                <li style="margin-bottom: 20px; font-size: 1rem; display: flex; align-items: flex-start; gap: 15px; line-height: 1.6;">
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem; margin-top: 8px;"></i>
                    Modern tesisleri ile altyapı ve üstyapı çözümleri sunan büyük bir üreticidir.
                </li>
                <li style="margin-bottom: 20px; font-size: 1rem; display: flex; align-items: flex-start; gap: 15px; line-height: 1.6;">
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem; margin-top: 8px;"></i>
                    Yılların getirdiği tecrübe ile yenilikçi ek parçalar ve sistemler üretir.
                </li>
                <li style="margin-bottom: 20px; font-size: 1rem; display: flex; align-items: flex-start; gap: 15px; line-height: 1.6;">
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem; margin-top: 8px;"></i>
                    HDPE, Elektrofüzyon ve Spigot ürünlerinde uzman, geniş ürün gamına sahiptir.
                </li>
                <li style="margin-bottom: 20px; font-size: 1rem; display: flex; align-items: flex-start; gap: 15px; line-height: 1.6;">
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem; margin-top: 8px;"></i>
                    Kalite ve inovasyonda her zaman sektöre öncülük etmeyi hedefler.
                </li>
            </ul>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const digerCheckbox = document.getElementById('diger-checkbox');
        const digerContainer = document.getElementById('diger-textarea-container');
        
        if (digerCheckbox && digerContainer) {
            digerCheckbox.addEventListener('change', function() {
                const digerTextarea = document.getElementById('diger-textarea');
                if (this.checked) {
                    digerContainer.style.display = 'block';
                    digerTextarea.setAttribute('required', 'required');
                } else {
                    digerContainer.style.display = 'none';
                    digerTextarea.removeAttribute('required');
                    digerTextarea.value = ''; // Optional: clear when unchecked
                }
            });
        }

        var form = document.getElementById('quote-form');
        if(form) {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // At least one product must be selected
                const checkboxes = document.querySelectorAll('input[name="products"]:checked');
                if(checkboxes.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Eksik Bilgi',
                        text: 'Lütfen ilgilendiğiniz en az bir ürünü seçin.',
                        confirmButtonColor: 'var(--primary)'
                    });
                    return;
                }
                
                const btn = this.querySelector('button[type="submit"]');
                const originalBtnHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Gönderiliyor...';
                btn.disabled = true;

                const formData = new FormData(this);
                let selectedProducts = Array.from(checkboxes).map(cb => cb.value);
                
                // If "Diğer" is checked, get the textarea text
                const digerTextarea = document.getElementById('diger-textarea');
                if (digerCheckbox && digerCheckbox.checked) {
                    // Replace "Diğer" with the custom text
                    const index = selectedProducts.indexOf('Diğer');
                    if (index !== -1) {
                        selectedProducts[index] = 'Diğer: ' + digerTextarea.value.trim();
                    }
                }

                const data = {
                    first_name: formData.get('first_name'),
                    last_name: formData.get('last_name'),
                    email: formData.get('email'),
                    phone: formData.get('phone'),
                    products: selectedProducts
                };

                fetch('/api/quote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Başarılı!',
                            text: data.message,
                            confirmButtonColor: 'var(--primary)'
                        });
                        form.reset();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Hata!',
                            text: data.error || 'Bir sorun oluştu.',
                            confirmButtonColor: 'var(--primary)'
                        });
                    }
                })
                .catch(err => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: 'Bağlantı hatası lütfen tekrar deneyin.',
                        confirmButtonColor: 'var(--primary)'
                    });
                })
                .finally(() => {
                    btn.innerHTML = originalBtnHtml;
                    btn.disabled = false;
                });
            });
        }
    });
</script>

<%- include('partials/footer') %>
